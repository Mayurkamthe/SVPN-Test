<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 mr-3 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <a href="/admin/groups" class="text-slate-400 hover:text-slate-600">&larr;</a>
          <div>
            <h1 class="text-lg font-bold text-slate-900"><%= group.name %></h1>
            <p class="text-xs text-slate-400"><%= members.length %> students &middot; AY <%= group.academicYear %></p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href="/admin/groups/<%= group.id %>/credentials-pdf" class="text-xs font-semibold border border-slate-200 text-slate-600 px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">Credentials PDF</a>
          <button onclick="document.getElementById('addStudentModal').classList.remove('hidden')" class="text-xs font-semibold bg-navy-950 text-white px-3 py-2 rounded-lg hover:bg-navy-900 transition-colors">+ Add Student</button>
        </div>
      </div>
    </header>

    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-[11px] font-semibold text-slate-400 uppercase tracking-wider">#</th>
                <th class="px-6 py-3 text-left text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Student</th>
                <th class="px-6 py-3 text-left text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Roll No</th>
                <th class="px-6 py-3 text-left text-[11px] font-semibold text-slate-400 uppercase tracking-wider hidden md:table-cell">Parent Contact</th>
                <th class="px-6 py-3 text-left text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-right text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% members.forEach((s, i) => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-400 text-xs"><%= i + 1 %></td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-navy-100 flex items-center justify-center text-navy-700 font-bold text-xs shrink-0"><%= s.name.charAt(0).toUpperCase() %></div>
                    <span class="font-medium text-slate-900"><%= s.name %></span>
                  </div>
                </td>
                <td class="px-6 py-4 font-mono text-slate-600 text-xs"><%= s.rollNo %></td>
                <td class="px-6 py-4 text-slate-500 hidden md:table-cell"><%= s.parentContact || '—' %></td>
                <td class="px-6 py-4">
                  <span class="<%= s.isFirstLogin ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %> text-[11px] font-semibold px-2.5 py-1 rounded-full">
                    <%= s.isFirstLogin ? 'First Login' : 'Active' %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <a href="/admin/students/<%= s.id %>/view" class="text-xs font-semibold text-navy-600 hover:text-navy-800 px-2 py-1">View</a>
                    <button onclick="openMoveStudent('<%= s.id %>', `<%= s.name.replace(/`/g, '\\`') %>`)" class="text-xs font-semibold text-amber-600 hover:text-amber-800 px-2 py-1">Move</button>
                    <button onclick="openRemoveStudent('<%= s.id %>', `<%= s.name.replace(/`/g, '\\`') %>`)" class="text-xs font-semibold text-rose-500 hover:text-rose-700 px-2 py-1">Remove</button>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% if (members.length === 0) { %>
              <tr><td colspan="6" class="px-6 py-16 text-center text-slate-400">No students in this batch yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Add Student Modal -->
<div id="addStudentModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-md">
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
      <h3 class="font-bold text-slate-900">Add Student to <%= group.name %></h3>
      <button onclick="document.getElementById('addStudentModal').classList.add('hidden')" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <form action="/admin/groups/<%= group.id %>/add-student" method="POST" class="p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Full Name *</label>
        <input type="text" name="name" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" placeholder="Student full name"/>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Roll Number *</label>
        <input type="text" name="rollNo" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" placeholder="2024CE001"/>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Parent Contact No</label>
        <input type="text" name="parentContact" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" placeholder="10-digit mobile number"/>
      </div>
      <div class="flex gap-3 pt-1">
        <button type="submit" class="flex-1 bg-navy-950 text-white font-semibold py-3 rounded-xl hover:bg-navy-900 transition-colors">Add Student</button>
        <button type="button" onclick="document.getElementById('addStudentModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50 transition-colors">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Move Student Modal -->
<div id="moveStudentModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-sm">
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
      <h3 class="font-bold text-slate-900">Move Student</h3>
      <button onclick="document.getElementById('moveStudentModal').classList.add('hidden')" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <form id="moveStudentForm" action="" method="POST" class="p-6 space-y-4">
      <p class="text-sm text-slate-500">Move <strong id="moveStudentName"></strong> to a different batch:</p>
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Target Batch *</label>
        <select name="targetGroupId" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white">
          <% allGroups.forEach(g => { if (g.id !== group.id) { %><option value="<%= g.id %>"><%= g.name %></option><% } }) %>
        </select>
      </div>
      <div class="flex gap-3 pt-1">
        <button type="submit" class="flex-1 bg-amber-600 text-white font-semibold py-3 rounded-xl hover:bg-amber-700 transition-colors">Move Student</button>
        <button type="button" onclick="document.getElementById('moveStudentModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50 transition-colors">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Remove Student Modal -->
<div id="removeStudentModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-sm p-6 text-center">
    <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </div>
    <h3 class="font-bold text-slate-900 mb-1.5">Remove from Batch?</h3>
    <p class="text-sm text-slate-500 mb-5">Remove <strong id="removeStudentName"></strong> from this batch? Their account will not be deleted.</p>
    <form id="removeStudentForm" action="" method="POST" class="flex gap-3">
      <button type="submit" class="flex-1 bg-rose-600 text-white font-semibold py-3 rounded-xl hover:bg-rose-700 transition-colors">Yes, Remove</button>
      <button type="button" onclick="document.getElementById('removeStudentModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50 transition-colors">Cancel</button>
    </form>
  </div>
</div>

<script>
function openMoveStudent(studentId, name) {
  document.getElementById('moveStudentForm').action = '/admin/groups/<%= group.id %>/students/' + studentId + '/move';
  document.getElementById('moveStudentName').textContent = name;
  document.getElementById('moveStudentModal').classList.remove('hidden');
}
function openRemoveStudent(studentId, name) {
  document.getElementById('removeStudentForm').action = '/admin/groups/<%= group.id %>/students/' + studentId + '/remove';
  document.getElementById('removeStudentName').textContent = name;
  document.getElementById('removeStudentModal').classList.remove('hidden');
}
</script>
</body>
</html>
