<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center justify-between">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 mr-3 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div><h1 class="text-lg font-bold text-slate-900">Tests</h1><p class="text-sm text-slate-500"><%= tests.length %> tests total</p></div>
      <a href="/admin/tests/create" class="flex items-center gap-2 bg-navy-950 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-navy-800 transition-colors">+ Create Test</a>
    </header>
    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <!-- Filters -->
      <form method="GET" class="flex flex-wrap gap-3 mb-6">
        <select name="course" class="border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500">
          <option value="">All Courses</option>
          <% COURSES.forEach(c => { %><option value="<%= c %>" <%= filterCourse===c?'selected':'' %>><%= c %></option><% }) %>
        </select>
        <select name="subject" class="border border-slate-200 rounded-lg px-3 py-2 text-sm">
          <option value="">All Subjects</option>
          <% SUBJECTS.forEach(s => { %><option value="<%= s %>" <%= filterSubject===s?'selected':'' %>><%= s %></option><% }) %>
        </select>
        <button type="submit" class="bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-lg text-sm font-medium">Filter</button>
        <a href="/admin/tests" class="px-4 py-2 rounded-lg text-sm text-slate-500 hover:bg-slate-50">Clear</a>
      </form>

      <% if (!tests.length) { %>
      <div class="text-center py-20 text-slate-400">
        <div class="text-6xl mb-4">📝</div>
        <p class="text-lg font-semibold mb-2">No tests yet</p>
        <a href="/admin/tests/create" class="bg-navy-950 text-white px-6 py-3 rounded-xl font-semibold hover:bg-navy-800 transition-colors inline-block">Create First Test →</a>
      </div>
      <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        <% tests.forEach(test => { %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 flex flex-col hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center text-xl shrink-0">📝</div>
            <span class="text-xs px-2.5 py-1 rounded-full font-medium
              <%= test.status==='published'?'bg-green-100 text-green-700':test.status==='draft'?'bg-slate-100 text-slate-600':'bg-blue-100 text-blue-700' %>">
              <%= test.status %>
            </span>
          </div>
          <h3 class="font-bold text-slate-900 mb-1 flex-1"><%= test.title %></h3>
          <div class="flex flex-wrap gap-2 mb-3">
            <% if (test.course) { %><span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded"><%= test.course %></span><% } %>
            <% if (test.subject) { %><span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded"><%= test.subject %></span><% } %>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs text-slate-500 bg-slate-50 rounded-lg p-3 mb-4">
            <span>⏱ <%= test.duration %> mins</span>
            <span>📊 <%= test.totalMarks %> marks</span>
            <span>➖ <%= test.negativeMarking %> neg</span>
            <span>👥 <%= test.groups.map(g=>g.name).join(', ')||'No groups' %></span>
          </div>
          <div class="flex gap-2">
            <a href="/admin/tests/<%= test.id %>" class="flex-1 text-center text-sm font-semibold border border-slate-200 py-2 rounded-lg hover:bg-slate-50">View</a>
            <a href="/admin/tests/<%= test.id %>/edit" class="text-sm font-semibold border border-slate-200 px-3 py-2 rounded-lg hover:bg-slate-50" title="Edit">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </a>
            <button onclick="openDeleteTest('<%= test.id %>', `<%= test.title.replace(/`/g, '\\`') %>`)" class="text-sm font-semibold px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 transition-colors" title="Delete">
              <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
            <% if (test.status==='draft') { %>
            <form action="/admin/tests/<%= test.id %>/publish" method="POST">
              <button class="text-sm font-semibold bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700">Publish</button>
            </form>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </main>
</div>
<!-- Delete Test Modal -->
<div id="deleteTestModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
    <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    </div>
    <h3 class="font-bold text-slate-900 mb-1.5">Delete Test?</h3>
    <p class="text-sm text-slate-500 mb-5">Delete <strong id="deleteTestName"></strong>? This action cannot be undone.</p>
    <form id="deleteTestForm" action="" method="POST" class="flex gap-3">
      <button type="submit" class="flex-1 bg-rose-600 text-white font-semibold py-3 rounded-xl hover:bg-rose-700">Yes, Delete</button>
      <button type="button" onclick="document.getElementById('deleteTestModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button>
    </form>
  </div>
</div>
<script>
function openDeleteTest(id, name) {
  document.getElementById('deleteTestForm').action = '/admin/tests/' + id + '/delete';
  document.getElementById('deleteTestName').textContent = name;
  document.getElementById('deleteTestModal').classList.remove('hidden');
}
</script>
</body></html>
