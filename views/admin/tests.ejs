<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-student') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto bg-slate-50">

    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center gap-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div>
        <h1 class="text-lg font-bold text-slate-900">My Tests</h1>
        <p class="text-xs text-slate-400"><%= newTests.length + pendingTests.length %> available &middot; <%= solvedTests.length %> completed</p>
      </div>
    </header>

    <div class="p-5 lg:p-8 space-y-8">
      <%- include('../partials/flash') %>

      <%
        function fmtDate(d) {
          if (!d) return '';
          return new Date(d).toLocaleDateString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
        }
      %>

      <!-- ── NEW TESTS ──────────────────────────────────────────────────── -->
      <section>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-blue-500"></div>
          <h2 class="font-bold text-slate-800 text-sm uppercase tracking-wider">New Tests</h2>
          <span class="text-xs bg-blue-100 text-blue-700 font-semibold px-2 py-0.5 rounded-full"><%= newTests.length %></span>
        </div>
        <% if (newTests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-100 py-10 text-center text-slate-400 text-sm">No new tests right now.</div>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% newTests.forEach(({ test }) => {
            const now = new Date();
            const started = !test.startTime || new Date(test.startTime) <= now;
          %>
          <div class="bg-white rounded-2xl border border-blue-100 shadow-sm p-5 flex flex-col gap-3">
            <div class="flex items-start justify-between">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <% if (test.subject) { %><span class="text-[11px] bg-blue-50 text-blue-600 font-semibold px-2 py-0.5 rounded-full"><%= test.subject %></span><% } %>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug"><%= test.title %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= test.duration %> mins &middot; <%= test.totalMarks %> marks</p>
              <% if (test.endTime) { %><p class="text-[11px] text-rose-500 font-medium mt-1">Due: <%= fmtDate(test.endTime) %></p><% } %>
              <% if (!started) { %><p class="text-[11px] text-amber-600 font-medium mt-1">Opens: <%= fmtDate(test.startTime) %></p><% } %>
            </div>
            <% if (started) { %>
            <a href="/exam/<%= test.id %>/instructions" class="mt-auto w-full text-center text-sm font-semibold bg-blue-600 text-white py-2.5 rounded-xl hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
              Start Exam <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <% } else { %>
            <span class="mt-auto w-full text-center text-sm font-semibold bg-slate-100 text-slate-400 py-2.5 rounded-xl cursor-not-allowed">Upcoming</span>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>

      <!-- ── PENDING / IN-PROGRESS ──────────────────────────────────────── -->
      <section>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-amber-500"></div>
          <h2 class="font-bold text-slate-800 text-sm uppercase tracking-wider">Pending Tests</h2>
          <span class="text-xs bg-amber-100 text-amber-700 font-semibold px-2 py-0.5 rounded-full"><%= pendingTests.length %></span>
        </div>
        <% if (pendingTests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-100 py-10 text-center text-slate-400 text-sm">No tests in progress.</div>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% pendingTests.forEach(({ test }) => { %>
          <div class="bg-white rounded-2xl border border-amber-200 shadow-sm p-5 flex flex-col gap-3">
            <div class="flex items-start justify-between">
              <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-[11px] bg-amber-100 text-amber-700 font-semibold px-2 py-0.5 rounded-full">In Progress</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug"><%= test.title %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= test.duration %> mins &middot; <%= test.totalMarks %> marks</p>
              <% if (test.endTime) { %><p class="text-[11px] text-rose-500 font-medium mt-1">Due: <%= fmtDate(test.endTime) %></p><% } %>
            </div>
            <a href="/exam/<%= test.id %>/instructions" class="mt-auto w-full text-center text-sm font-semibold bg-amber-500 text-white py-2.5 rounded-xl hover:bg-amber-600 transition-colors flex items-center justify-center gap-2">
              Resume Exam <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>

      <!-- ── SOLVED TESTS ───────────────────────────────────────────────── -->
      <section>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
          <h2 class="font-bold text-slate-800 text-sm uppercase tracking-wider">Solved Tests</h2>
          <span class="text-xs bg-emerald-100 text-emerald-700 font-semibold px-2 py-0.5 rounded-full"><%= solvedTests.length %></span>
        </div>
        <% if (solvedTests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-100 py-10 text-center text-slate-400 text-sm">No completed tests yet.</div>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% solvedTests.forEach(({ test, result }) => {
            const pct = result && result.totalMarks > 0 ? ((result.score / result.totalMarks) * 100).toFixed(1) : 0;
            const clr = pct >= 60 ? 'emerald' : pct >= 40 ? 'amber' : 'rose';
          %>
          <div class="bg-white rounded-2xl border border-emerald-100 shadow-sm p-5 flex flex-col gap-3">
            <div class="flex items-start justify-between">
              <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-[11px] bg-emerald-100 text-emerald-700 font-semibold px-2 py-0.5 rounded-full">Completed</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug"><%= test.title %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= test.duration %> mins &middot; <%= test.totalMarks %> marks</p>
            </div>
            <% if (result) { %>
            <div class="bg-slate-50 rounded-xl px-4 py-3 flex items-center justify-between">
              <div>
                <p class="text-2xl font-bold text-<%= clr %>-600"><%= pct %>%</p>
                <p class="text-xs text-slate-400 mt-0.5"><%= result.score %>/<%= result.totalMarks %> marks</p>
              </div>
              <% if (result.rank) { %><span class="text-sm font-bold text-slate-500">Rank #<%= result.rank %></span><% } %>
            </div>
            <div class="flex gap-2 mt-auto">
              <a href="/results/<%= result.id %>" class="flex-1 text-center text-sm font-semibold bg-navy-950 text-white py-2.5 rounded-xl hover:bg-navy-800 transition-colors">View Result</a>
              <a href="/results/leaderboard/<%= test.id %>" class="w-11 flex items-center justify-center border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors" title="Leaderboard">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </a>
            </div>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>

      <!-- ── EXPIRED TESTS ──────────────────────────────────────────────── -->
      <% if (expiredTests.length > 0) { %>
      <section>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-rose-400"></div>
          <h2 class="font-bold text-slate-800 text-sm uppercase tracking-wider">Expired Tests</h2>
          <span class="text-xs bg-rose-100 text-rose-600 font-semibold px-2 py-0.5 rounded-full"><%= expiredTests.length %></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% expiredTests.forEach(({ test }) => { %>
          <div class="bg-white rounded-2xl border border-rose-100 shadow-sm p-5 flex flex-col gap-3 opacity-75">
            <div class="flex items-start justify-between">
              <div class="w-10 h-10 bg-rose-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-[11px] bg-rose-100 text-rose-500 font-semibold px-2 py-0.5 rounded-full">Expired</span>
            </div>
            <div>
              <h3 class="font-bold text-slate-700 text-sm leading-snug"><%= test.title %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= test.duration %> mins &middot; <%= test.totalMarks %> marks</p>
              <% if (test.endTime) { %><p class="text-[11px] text-rose-400 font-medium mt-1">Expired: <%= fmtDate(test.endTime) %></p><% } %>
            </div>
            <span class="mt-auto w-full text-center text-sm font-semibold bg-slate-100 text-slate-400 py-2.5 rounded-xl cursor-not-allowed">Expired</span>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>

    </div>
  </main>
</div>
</body>
</html>
