<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center gap-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex-1">
        <h1 class="text-lg font-bold text-slate-900">Upload Test via PDF</h1>
        <p class="text-xs text-slate-400">Upload a question paper PDF — 1 question per page</p>
      </div>
      <a href="/admin/tests/template/pdf" target="_blank"
        class="inline-flex items-center gap-1.5 text-xs font-semibold bg-indigo-600 text-white px-3 py-2 rounded-lg hover:bg-indigo-700 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
        Question Paper Template
      </a>
      <a href="/admin/tests/template/answer-key" target="_blank"
        class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-600 text-white px-3 py-2 rounded-lg hover:bg-emerald-700 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Answer Key Template
      </a>
    </header>

    <div class="p-5 lg:p-8 max-w-3xl mx-auto">
      <%- include('../partials/flash') %>

      <form action="/admin/tests/upload-pdf" method="POST" enctype="multipart/form-data" class="space-y-6">

        <!-- Step 1: Test Details -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
          <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
            <span class="w-6 h-6 bg-navy-950 text-white rounded-full flex items-center justify-center text-xs font-bold">1</span>
            Test Details
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Test Title *</label>
              <input type="text" name="title" required placeholder="e.g. CET Mock Test 1 — PCM"
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Description</label>
              <textarea name="description" rows="2" placeholder="Brief description of this test..."
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500 resize-none"></textarea>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Duration (minutes) *</label>
              <input type="number" name="duration" value="180" min="5" required
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Marks per Question</label>
              <input type="number" name="marksPerQuestion" value="1" step="0.5" min="0.5"
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Negative Marking</label>
              <input type="number" name="negativeMarking" value="0.25" step="0.25" min="0"
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Start Time</label>
              <input type="datetime-local" name="startTime"
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Course</label>
              <div class="flex flex-wrap gap-2">
                <% COURSES.forEach(c => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-50 transition-colors text-sm">
                  <input type="checkbox" name="courses" value="<%= c %>" class="rounded"/>
                  <span class="font-medium text-slate-700"><%= c %></span>
                </label>
                <% }) %>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Subject</label>
              <div class="flex flex-wrap gap-2">
                <% SUBJECTS.forEach(s => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-50 transition-colors text-sm">
                  <input type="checkbox" name="subjects" value="<%= s %>" class="rounded"/>
                  <span class="font-medium text-slate-700"><%= s %></span>
                </label>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: PDF Upload -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
          <h2 class="font-bold text-slate-800 mb-2 flex items-center gap-2">
            <span class="w-6 h-6 bg-navy-950 text-white rounded-full flex items-center justify-center text-xs font-bold">2</span>
            Upload PDFs
          </h2>
          <p class="text-xs text-slate-500 mb-4">Question PDF must have <strong>exactly 1 question per page</strong>. Page count = question count. Total marks = pages × marks/question.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Question PDF -->
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">📝 Question Paper PDF *</label>
              <div id="qPdfDrop" onclick="document.getElementById('questionPdf').click()"
                class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center cursor-pointer hover:border-navy-400 hover:bg-navy-50 transition-all">
                <div id="qPdfIcon" class="flex flex-col items-center gap-2">
                  <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                  <p class="text-sm text-slate-400 font-medium">Click to upload Question PDF</p>
                  <p class="text-xs text-slate-300">PDF only · Max 20 MB</p>
                </div>
                <div id="qPdfPreview" class="hidden flex-col items-center gap-2">
                  <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <p id="qPdfName" class="text-sm font-semibold text-emerald-700 break-all"></p>
                  <p id="qPdfSize" class="text-xs text-slate-400"></p>
                  <button type="button" onclick="clearPdf('q',event)" class="text-xs text-rose-500 hover:text-rose-700 font-medium mt-1">✕ Remove</button>
                </div>
              </div>
              <input type="file" id="questionPdf" name="questionPdf" accept="application/pdf" required class="hidden" onchange="selectPdf(this,'q')"/>
            </div>

            <!-- Solution PDF -->
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">✅ Answer Key / Solution PDF <span class="text-slate-300 font-normal">(optional)</span></label>
              <div id="sPdfDrop" onclick="document.getElementById('solutionPdf').click()"
                class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center cursor-pointer hover:border-emerald-400 hover:bg-emerald-50 transition-all">
                <div id="sPdfIcon" class="flex flex-col items-center gap-2">
                  <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                  <p class="text-sm text-slate-400 font-medium">Click to upload Solution PDF</p>
                  <p class="text-xs text-slate-300">PDF only · Max 20 MB · Optional</p>
                </div>
                <div id="sPdfPreview" class="hidden flex-col items-center gap-2">
                  <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <p id="sPdfName" class="text-sm font-semibold text-emerald-700 break-all"></p>
                  <p id="sPdfSize" class="text-xs text-slate-400"></p>
                  <button type="button" onclick="clearPdf('s',event)" class="text-xs text-rose-500 hover:text-rose-700 font-medium mt-1">✕ Remove</button>
                </div>
              </div>
              <input type="file" id="solutionPdf" name="solutionPdf" accept="application/pdf" class="hidden" onchange="selectPdf(this,'s')"/>
            </div>
          </div>

          <!-- Info box -->
          <div class="mt-4 bg-blue-50 border border-blue-200 rounded-xl p-4 text-xs text-blue-800 space-y-1">
            <p>📌 <strong>1 question per page</strong> — number of pages = number of questions.</p>
            <p>🖼 Images and diagrams embedded in PDF render automatically for students.</p>
            <p>📐 Total marks = page count × marks per question (set above).</p>
            <p>✅ <strong>Answer Key PDF:</strong> Download the <a href="/admin/tests/template/answer-key" target="_blank" class="underline font-semibold text-blue-700">Answer Key Template</a>, fill in correct answers + explanations, then upload above as Solution PDF.</p>
          </div>
        </div>

        <!-- Step 3: Assign Batches -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
          <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
            <span class="w-6 h-6 bg-navy-950 text-white rounded-full flex items-center justify-center text-xs font-bold">3</span>
            Assign to Batches
          </h2>
          <% if (groups.length) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% groups.forEach(g => { %>
            <label class="flex items-center gap-3 p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
              <input type="checkbox" name="groupIds" value="<%= g.id %>" class="rounded"/>
              <span class="text-sm font-medium text-slate-700"><%= g.name %></span>
              <span class="ml-auto text-xs text-slate-400"><%= g.academicYear %></span>
            </label>
            <% }) %>
          </div>
          <% } else { %>
          <p class="text-sm text-slate-400">No batches created yet. <a href="/admin/groups" class="text-navy-600 hover:underline">Create a batch first.</a></p>
          <% } %>
        </div>

        <!-- Step 4: Anti-Cheat -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
          <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
            <span class="w-6 h-6 bg-navy-950 text-white rounded-full flex items-center justify-center text-xs font-bold">4</span>
            Anti-Cheat Settings
          </h2>
          <div class="space-y-3">
            <label class="flex items-center justify-between p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50">
              <div>
                <p class="text-sm font-semibold text-slate-800">Auto-Submit on Violation</p>
                <p class="text-xs text-slate-400">Force submit exam when tab switch limit is exceeded</p>
              </div>
              <input type="checkbox" name="autoSubmitOnViolation" class="rounded w-5 h-5"/>
            </label>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Max Tab Switches</label>
                <input type="number" name="maxTabSwitches" value="3" min="1" max="20"
                  class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Max Focus Losses</label>
                <input type="number" name="maxFocusLosses" value="5" min="1" max="20"
                  class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/>
              </div>
            </div>
            <label class="flex items-center justify-between p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50">
              <div>
                <p class="text-sm font-semibold text-slate-800">Block Copy/Paste</p>
                <p class="text-xs text-slate-400">Prevents Ctrl+C, Ctrl+V and right-click</p>
              </div>
              <input type="checkbox" name="blockCopyPaste" checked class="rounded w-5 h-5"/>
            </label>
          </div>
        </div>

        <!-- Submit -->
        <div class="flex gap-4">
          <button type="submit" id="uploadBtn"
            class="flex-1 bg-navy-950 text-white font-bold py-4 rounded-xl hover:bg-navy-800 transition-colors text-base shadow-lg flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Upload & Create Test
          </button>
          <a href="/admin/tests" class="px-8 py-4 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 flex items-center">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>

<script>
function selectPdf(input, prefix) {
  const file = input.files[0];
  if (!file) return;
  if (file.type !== 'application/pdf') {
    alert('Please select a PDF file only.');
    input.value = '';
    return;
  }
  const sizeMB = (file.size / 1024 / 1024).toFixed(1);
  document.getElementById(prefix + 'PdfIcon').classList.add('hidden');
  const prev = document.getElementById(prefix + 'PdfPreview');
  prev.classList.remove('hidden');
  prev.classList.add('flex');
  document.getElementById(prefix + 'PdfName').textContent = file.name;
  document.getElementById(prefix + 'PdfSize').textContent = sizeMB + ' MB';
}

function clearPdf(prefix, e) {
  e.stopPropagation();
  const inputId = prefix === 'q' ? 'questionPdf' : 'solutionPdf';
  document.getElementById(inputId).value = '';
  document.getElementById(prefix + 'PdfIcon').classList.remove('hidden');
  const prev = document.getElementById(prefix + 'PdfPreview');
  prev.classList.add('hidden');
  prev.classList.remove('flex');
}

// Show loading on submit
document.querySelector('form').addEventListener('submit', function(e) {
  const qFile = document.getElementById('questionPdf').files[0];
  if (!qFile) { e.preventDefault(); alert('Please upload a Question PDF.'); return; }
  const btn = document.getElementById('uploadBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Uploading...';
});
</script>
</body>
</html>
