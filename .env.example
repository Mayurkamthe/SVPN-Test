# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/svpn_test?retryWrites=true&w=majority

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SESSION_SECRET=change_me_to_a_random_string
APP_NAME=CET Exam Portal

# ── College branding ──────────────────────────────────────────────────────────
COLLEGE_NAME=Your College Name
COLLEGE_SHORT_NAME=CET
ACADEMIC_YEAR=2024-2025
COLLEGE_ADDRESS=Your Address

# ── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Administrator

# ── File upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=20971520

# ── Connection pool ───────────────────────────────────────────────────────────
DB_POOL_MAX=15
